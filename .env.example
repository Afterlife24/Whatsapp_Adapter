# Dograh backend URL (with /api/v1 prefix)
DOGRAH_API_BASE=http://localhost:8000/api/v1

# Single-agent setup: one WhatsApp number → one Dograh agent
DOGRAH_API_KEY=dk_your_api_key_here
DOGRAH_TRIGGER_PATH=your-trigger-uuid-here

# Multi-agent setup (optional): JSON mapping of WhatsApp numbers to agents
# Each Twilio WhatsApp number maps to a different org's API key + trigger
# Add "followups_enabled": true and optional "followup_delays": [300, 900, 1800, 10800]
# to enable the follow-up scheduler for a specific agent.
#
# AGENT_MAPPINGS={"+1XXXXXXXXXX": {"api_key": "dk_xxx", "trigger_path": "uuid-xxx"}, "+91XXXXXXXXXX": {"api_key": "dk_rehabb", "trigger_path": "uuid-rehabb", "followups_enabled": true, "followup_delays": [300, 900, 1800, 10800]}}

# Twilio credentials
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=whatsapp_adapter

# Adapter Authentication (Phase 1)
ADAPTER_ADMIN_PASSWORD=your_secure_password_here
ADAPTER_SESSION_SECRET=your_random_secret_key_here

# Dashboard Origin (for CORS). ADAPTER_CORS_ORIGIN is the preferred name and
# takes precedence; DASHBOARD_ORIGIN is kept for backward compatibility.
ADAPTER_CORS_ORIGIN=http://localhost:3001
DASHBOARD_ORIGIN=http://localhost:3001

# ── Operator billing console → AgentX internal credits API (Phase 6) ────────
# Shared secret, MUST match DOGRAH_INTERNAL_SECRET on the AgentX (api) side.
# The adapter forwards it to AgentX over the internal Docker network. It is
# NEVER sent to the dashboard (browser) bundle. Use openssl rand -hex 32.
DOGRAH_INTERNAL_SECRET=change-me-dograh-internal-secret

# Base URL of the AgentX internal API, reached over the internal Docker
# network. Default works inside docker-compose.
AGENTX_INTERNAL_BASE=http://api:8000/api/v1

# Default INR→USD rate pre-filled (and editable) in the record-payment form.
# Baked into the dashboard bundle at build time via NEXT_PUBLIC_DEFAULT_USD_INR_RATE.
DEFAULT_USD_INR_RATE=0.0112
