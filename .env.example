# Dograh backend URL (with /api/v1 prefix)
DOGRAH_API_BASE=http://localhost:8000/api/v1

# Single-agent setup: one WhatsApp number → one Dograh agent
DOGRAH_API_KEY=dk_your_api_key_here
DOGRAH_TRIGGER_PATH=your-trigger-uuid-here

# Multi-agent setup (optional): JSON mapping of WhatsApp numbers to agents
# Each Twilio WhatsApp number maps to a different org's API key + trigger
# Add "followups_enabled": true and optional "followup_delays": [300, 900, 1800, 10800]
# to enable the follow-up scheduler for a specific agent.
#
# AGENT_MAPPINGS={"+1XXXXXXXXXX": {"api_key": "dk_xxx", "trigger_path": "uuid-xxx"}, "+91XXXXXXXXXX": {"api_key": "dk_rehabb", "trigger_path": "uuid-rehabb", "followups_enabled": true, "followup_delays": [300, 900, 1800, 10800]}}

# Twilio credentials
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=whatsapp_adapter
